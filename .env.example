# Telegram Bot Configuration
# Получите токен бота у @BotFather в Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ID чата или группы, куда будут приходить заказы
# Получите ID через @userinfobot
TELEGRAM_CHAT_ID=your_chat_id_here

# URL сайта для SEO
NEXT_PUBLIC_SITE_URL=https://psorus.com

# Yandex Metrika ID (опционально)
NEXT_PUBLIC_YANDEX_METRIKA_ID=your_metrika_id_here
